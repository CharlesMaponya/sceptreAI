FROM python:3.12.13-slim-trixie@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

RUN apt-get update \
    && apt-get upgrade --no-install-recommends --yes \
       bsdutils gzip libacl1 libblkid1 liblastlog2-2 libmount1 \
       libncursesw6 libsmartcols1 libsqlite3-0 libuuid1 login mount \
       ncurses-base ncurses-bin openssl openssl-provider-legacy perl-base util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip==26.1.2 \
    && python -m pip install --no-cache-dir \
    mlflow==3.15.1 \
    "psycopg[binary]==3.3.4" \
    "GitPython>=3.1.52" \
    "pillow>=12.3.0" \
    "pyasn1>=0.6.4" \
    "setuptools>=78.1.1" \
    "wheel>=0.46.2"
COPY scripts/mlflow_migrate_if_initialized.py /opt/automl/mlflow_migrate_if_initialized.py
RUN useradd --create-home --uid 10001 sceptre \
    && mkdir --parents /mlflow \
    && chown --recursive 10001:10001 /mlflow /opt/automl
USER 10001
