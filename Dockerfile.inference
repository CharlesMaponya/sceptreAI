FROM python:3.12.13-slim-trixie@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

ARG SCEPTRE_VERSION=0.0.0
WORKDIR /app
COPY requirements-inference.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip==26.1.2 \
    && python -m pip install -r requirements-inference.txt

COPY requirements-inference-upload.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r requirements-inference-upload.txt

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api ./apps/api
COPY packages ./packages

ENV PYTHONPATH=/app/apps/api:/app/packages
ENV PYTHONUNBUFFERED=1
ENV SCEPTRE_VERSION=${SCEPTRE_VERSION}

RUN useradd --create-home --uid 10001 sceptre
USER 10001

EXPOSE 8080
CMD ["uvicorn", "automl_api.inference.app:app", "--host", "0.0.0.0", "--port", "8080"]
