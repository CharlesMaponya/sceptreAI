FROM docker.io/rapidsai/base:26.06-cuda12-py3.12

USER root

WORKDIR /app
COPY requirements-training.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.1.2 \
    && sed 's/^xgboost-cpu/xgboost/' requirements-training.txt \
       > /tmp/requirements-training-gpu.txt \
    && python -m pip install --no-cache-dir -r /tmp/requirements-training-gpu.txt

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api ./apps/api
COPY packages ./packages

# P8-W07: run as an unbound numeric non-root user; the RAPIDS base image does
# not define a named non-root account.
RUN chown -R 10001:10001 /app
ENV PYTHONPATH=/app/apps/api:/app/packages
ENV PYTHONUNBUFFERED=1
USER 10001
CMD ["python", "-m", "automl_api.training.worker", "--help"]
