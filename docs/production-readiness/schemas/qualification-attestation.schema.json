{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceptre.ai/schemas/qualification-attestation-v1.json",
  "title": "Sceptre qualification attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_revision",
    "qualification_label",
    "decision",
    "decided_at",
    "artifact_manifest_digest",
    "decision_register_digest",
    "go_no_go_record_digest",
    "providers",
    "final_allocations",
    "approvers",
    "signatures"
  ],
  "properties": {
    "schema_revision": {"const": "sceptre-qualification-attestation-v1"},
    "qualification_label": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$"},
    "decision": {"enum": ["approved", "rejected", "no_go"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
    "decision_register_digest": {"$ref": "#/$defs/digest"},
    "go_no_go_record_digest": {"$ref": "#/$defs/digest"},
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aws-eks", "gcp-gke", "azure-aks"],
      "properties": {
        "aws-eks": {"$ref": "#/$defs/provider"},
        "gcp-gke": {"$ref": "#/$defs/provider"},
        "azure-aks": {"$ref": "#/$defs/provider"}
      }
    },
    "final_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "canonical_provider", "allocation_receipt_digest", "result_digest"],
        "properties": {
          "task": {"enum": ["classification", "regression", "time_series", "clustering"]},
          "canonical_provider": {"enum": ["aws-eks", "gcp-gke", "azure-aks"]},
          "allocation_receipt_digest": {"$ref": "#/$defs/digest"},
          "result_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "approvers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "role", "approved_at"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_bom_digest", "capacity_profile_digest", "evidence_manifest_digest"],
      "properties": {
        "platform_bom_digest": {"$ref": "#/$defs/digest"},
        "capacity_profile_digest": {"$ref": "#/$defs/digest"},
        "evidence_manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject", "bundle_digest"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "bundle_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
