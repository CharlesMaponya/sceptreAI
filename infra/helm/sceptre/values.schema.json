{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {"type": "string"},
        "imagePullSecrets": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "kuberay-operator": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "fullnameOverride": {"type": "string", "minLength": 1},
        "singleNamespaceInstall": {"const": true},
        "crNamespacedRbacEnable": {"const": true},
        "leaderElectionEnabled": {"type": "boolean"},
        "reconcileConcurrency": {"type": "integer", "minimum": 1}
      },
      "required": ["enabled", "singleNamespaceInstall", "crNamespacedRbacEnable"]
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "properties": {
            "tag": {"type": "string"},
            "digest": {"type": "string"}
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "qualificationDatabaseUrlKey": {"type": "string", "minLength": 1},
        "database": {
          "type": "object",
          "properties": {
            "poolSize": {"type": "integer", "minimum": 1},
            "maxOverflow": {"type": "integer", "minimum": 0},
            "poolTimeoutSeconds": {"type": "integer", "minimum": 1},
            "connectTimeoutSeconds": {"type": "integer", "minimum": 1},
            "statementTimeoutMs": {"type": "integer", "minimum": 1},
            "lockTimeoutMs": {"type": "integer", "minimum": 1},
            "idleTransactionTimeoutMs": {"type": "integer", "minimum": 1},
            "applicationName": {"type": "string", "minLength": 1},
            "sslMode": {"enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]},
            "sslRootCert": {"type": "string"},
            "pgbouncerTransactionMode": {"type": "boolean"}
          },
          "required": ["poolSize", "maxOverflow", "poolTimeoutSeconds", "connectTimeoutSeconds", "statementTimeoutMs", "lockTimeoutMs", "idleTransactionTimeoutMs", "applicationName", "sslMode", "pgbouncerTransactionMode"]
        }
      }
    },
    "reconciler": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "pollSeconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "required": ["replicaCount", "pollSeconds"]
    },
    "seaweedfs": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "properties": {
            "tag": {"type": "string"},
            "digest": {"type": "string"}
          }
        },
        "bucket": {"type": "string", "minLength": 1},
        "publicEndpoint": {"type": "string", "minLength": 1},
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "host": {"type": "string", "minLength": 1},
            "annotations": {"type": "object"}
          },
          "required": ["enabled", "host"]
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "minLength": 1}
          }
        }
      },
      "required": ["enabled"]
    },
    "externalObjectStore": {
      "type": "object",
      "properties": {
        "driver": {"enum": ["s3_compatible", "aws_s3", "gcs", "azure_blob"]},
        "endpoint": {"type": "string"},
        "publicEndpoint": {"type": "string"},
        "region": {"type": "string"},
        "gcsProject": {"type": "string"},
        "azureStorageAccount": {"type": "string"},
        "bucket": {"type": "string", "minLength": 1}
      },
      "required": ["driver", "bucket"]
    },
    "uploads": {
      "type": "object",
      "properties": {
        "allowedOrigins": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "partSizeBytes": {"type": "integer", "minimum": 5242880},
        "instructionTtlSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "sessionTtlSeconds": {"type": "integer", "minimum": 900},
        "bufferedUploadMaxBytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "maxUploadSizeBytes": {"type": "integer", "minimum": 104857600},
        "maxDecompressionRatio": {"type": "integer", "minimum": 1},
        "maxDecompressedBytes": {"type": "integer", "minimum": 1},
        "projectStorageQuotaBytes": {"type": "integer", "minimum": 1},
        "quarantineRetentionSeconds": {"type": "integer", "minimum": 3600},
        "scanner": {
          "type": "object",
          "properties": {
            "command": {"type": "string"},
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "version": {"type": "string", "minLength": 1},
            "signatureVersion": {"type": "string", "minLength": 1}
          },
          "required": ["command", "timeoutSeconds", "version", "signatureVersion"]
        }
      },
      "required": ["allowedOrigins", "partSizeBytes", "instructionTtlSeconds", "sessionTtlSeconds", "bufferedUploadMaxBytes", "maxUploadSizeBytes", "maxDecompressionRatio", "maxDecompressedBytes", "projectStorageQuotaBytes", "quarantineRetentionSeconds", "scanner"]
    },
    "mlflow": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "workers": {"type": "integer", "minimum": 1}
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "maxConcurrentJobs": {"type": "integer", "minimum": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 604800},
        "maxActiveDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 604800},
        "deadlineMultiplier": {"type": "integer", "minimum": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "cpu": {
          "type": "object",
          "properties": {
            "requestCores": {"type": "number", "minimum": 0.25},
            "limitCores": {"type": "number", "minimum": 0.25},
            "memoryRequestMb": {"type": "integer", "minimum": 256},
            "memoryLimitMb": {"type": "integer", "minimum": 256}
          }
        },
        "cache": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["ephemeral", "shared-pvc"]},
            "emptyDirSizeGb": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "inference": {
      "type": "object",
      "properties": {
        "serviceType": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "externalScheme": {"enum": ["http", "https"]}
      }
    }
  }
}
